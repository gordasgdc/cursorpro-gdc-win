<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta pentru tema închisă. Aceleași chei ca în Theme.Light.xaml,
         valori diferite — dicționarul se schimbă întreg la comutare. -->
    <Color x:Key="WindowBackgroundColor">#1B1D21</Color>
    <Color x:Key="CardBackgroundColor">#24262B</Color>
    <Color x:Key="CardStrokeColor">#33363D</Color>
    <Color x:Key="TextPrimaryColor">#EDEFF2</Color>
    <Color x:Key="TextSecondaryColor">#A8ADB5</Color>
</ResourceDictionary>
