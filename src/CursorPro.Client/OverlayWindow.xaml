<!-- theme-exempt: suprafață de desen transparentă, nu interfață.
     Fereastra e WindowStyle=None + AllowsTransparency, întinsă peste tot
     ecranul, și desenează spotlight-ul peste ce e dedesubt. Un fundal de
     temă aici ar acoperi ecranul cu o culoare opacă. -->
<Window x:Class="CursorPro.Client.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="False">
</Window>
