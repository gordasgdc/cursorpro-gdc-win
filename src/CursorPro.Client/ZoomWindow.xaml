<!-- theme-exempt: fereastra lupei. Rama e neagră în ambele teme, ca
     referință neutră pentru pixelii măriți ai ecranului. -->
<Window x:Class="CursorPro.Client.ZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource MagnifierSurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="False">
</Window>
